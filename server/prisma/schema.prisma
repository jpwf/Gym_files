// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  secretkey String   @map("secretkey")
  admin     Boolean  @default(false) 
  added   DateTime @default(now()) @map("added")

  @@map("users")
}